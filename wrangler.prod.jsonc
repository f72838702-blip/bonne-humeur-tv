// Configuration Cloudflare Workers — Bonne Humeur TV — PRODUCTION (Phase J)
// URL publique : https://bonne-humeur-tv.bonne-humeur-tv.workers.dev
// Déploiement : npx wrangler deploy -c wrangler.prod.jsonc
// Miroir exact de la recette preview validée (Version 48ac8fd0) sur main f0e3800.
{
  // Worker PRODUCTION (le preview reste distinct : bonne-humeur-tv-preview).
  "name": "bonne-humeur-tv",
  // Date de compatibilité : généraux, nodejs_compat requis par OpenNext (Server Actions, Supabase ssr…)
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI — plan Free (10 000 Neurons/jour), AUCUN moyen de paiement.
  // Le binding est l'ACCÈS UNIQUE aux modèles (aucune clé API, aucun secret).
  "ai": { "binding": "AI" },
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  }
}
