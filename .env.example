# ═══════════════════════════════════════════════════════════════════
# BONNE HUMEUR TV — Variables d'environnement
# Copier en `.env.local` (développement) et configurer dans Vercel
# (Production → Settings → Environment Variables).
# Seules les variables NEXT_PUBLIC_* sont exposées au navigateur.
# ═══════════════════════════════════════════════════════════════════

# ── Supabase (OBLIGATOIRE pour le CMS et les formulaires) ──────────
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé service_role — SERVEUR UNIQUEMENT, JAMAIS de préfixe NEXT_PUBLIC_.
# Requise pour : invitations d'utilisateurs, médiathèque (Storage),
# rate limiting des formulaires. Sans elle, ces fonctions affichent
# un état « non configuré » honnête.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ── SEO / URL publique (recommandé) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bonne-humeur-tv.vercel.app

# ── Turnstile (Cloudflare) — OPTIONNEL ─────────────────────────────
# Protection anti-robot des formulaires. Sans ces clés, les formulaires
# fonctionnent avec honeypot + rate limiting (état documenté).
# https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── YouTube Data API v3 — OPTIONNEL (directive §1) ────────────────
# SERVEUR UNIQUEMENT, JAMAIS de préfixe NEXT_PUBLIC_. Sert à importer
# les métadonnées (titre, description, miniature, durée, statut réel
# de direct) dans le formulaire vidéo du CMS. Sans cette clé, l'ajout
# manuel fonctionne normalement (message honnête dans l'interface).
# Un cache serveur (1 h) limite la consommation de quota.
# https://console.cloud.google.com → Activer « YouTube Data API v3 » → Clé API
YOUTUBE_API_KEY=

# ── Brevo (envoi des réponses aux demandes) — OPTIONNEL ─────────────
# SERVEUR UNIQUEMENT, JAMAIS de préfixe NEXT_PUBLIC_. Clé API v3 du plan
# gratuit (300 e-mails/jour). Sert à envoyer les réponses de l'administrateur
# depuis l'onglet Demandes. Sans ces clés, le bouton Répondre affiche un état
# « non configuré » honnête. L'adresse expéditrice doit être VÉRIFIÉE dans
# Brevo (code à 6 chiffres reçu par e-mail — aucun domaine requis).
# BREVO_REPLY_TO_EMAIL (optionnel) : les réponses des visiteurs arrivent sur
# cette boîte ; par défaut, sur BREVO_SENDER_EMAIL.
# https://app.brevo.com → SMTP & API → Clé API v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bonne Humeur TV
BREVO_REPLY_TO_EMAIL=