// Configuration Cloudflare Workers — Bonne Humeur Média
// Branche deploy/cloudflare-staging.
// AUCUN déploiement distant : preview LOCALE uniquement à ce stade
// (wrangler dev) ; toute mise en ligne exige l'autorisation de la direction.
{
  // Nom du Worker en prévisualisation isolée (jamais de domaine réel)
  "name": "bonne-humeur-tv-preview",
  // Domaine officiel acheté par la direction (Namecheap) — zone Cloudflare
  // Free même compte ; certificat HTTPS Universal (gratuit) provisionné
  // automatiquement par Cloudflare pour domain + www.
  "routes": [
    { "pattern": "bonnehumeur.info", "custom_domain": true },
    { "pattern": "www.bonnehumeur.info", "custom_domain": true },
  ],
  // workers.dev FERMÉ (demande direction 07/11 — « ferme le workers.dev ») :
  // une seule adresse officielle = bonnehumeur.info (+ www), zéro doublon.
  "workers_dev": false,
  // Date de compatibilité : généraux, nodejs_compat requis par OpenNext (Server Actions, Supabase ssr…)
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI — plan Free (10 000 Neurons/jour), AUCUN moyen de paiement.
  // Le binding est l'ACCÈS UNIQUE aux modèles (aucune clé API, aucun secret).
  "ai": { "binding": "AI" },
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  }
}